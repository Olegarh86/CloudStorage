POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=your_secure_s3_password

POSTGRES_DB=db_storage
JAVA_DB_URL=jdbc:postgresql://db_storage:5432/db_storage
REDIS_HOST=redis_storage
REDIS_PORT=6379
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=user-files
SERVER_PORT=8090
MAX_FILE_SIZE=2500MB
MAX_REQUEST_SIZE=5000MB
REDIS_FLUSH_MODE=on_save
REDIS_NAMESPACE=cloudStorage:session